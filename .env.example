# .env.example — the-replicant-theme
# Copier en .env (gitignoré) et remplir hors-ligne. AUCUN secret dans le chat, les logs ou les commits.
# Rappel : le token GitHub global vit dans ~/.hermes/secrets/github-global.env (compte jeromepepermans).

# --- SSH (hébergement o2switch, compte nilgaut) ---
SSH_HOST=nilgaut.o2switch.net
SSH_PORT=22
SSH_USER=djdj2187
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# --- PrestaShop ---
SHOP_URL=https://www.the-replicant.com
SHOP_ENV=production
SHOP_DIR=~/the-replicant.com
PRESTASHOP_ADMIN_URL=
PREPROD_URL=https://preprod.the-replicant.com
PREPROD_DIR=~/preprod.the-replicant.com

# --- Thème ---
THEME_NAME=replicant
THEME_SLUG=replicant
MODULE_COMPAGNON=replicanttheme

# --- Navigation de support (tests navigateur) ---
SUPPORT_USERNAME=
SUPPORT_PASSWORD=
